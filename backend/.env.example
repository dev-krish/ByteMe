# Database (PostgreSQL + PostGIS)
# Example for Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Example for Neon: postgresql://[USER]:[PASSWORD]@[HOST]/[DB]?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/nlams?schema=public"

# JWT
JWT_SECRET="nlams-sih2026-byteme-jwt-secret-change-in-production"
JWT_EXPIRES_IN="24h"

# Server
PORT=4000
NODE_ENV="development"

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,https://byteme-opal.vercel.app"
