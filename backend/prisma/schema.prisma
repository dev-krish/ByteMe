// NLAMS — National Land Acquisition & Management System
// Prisma Schema for SIH 2026, Team ByteMe
// PostgreSQL + PostGIS
//
// Note: PostGIS geometry columns are handled via raw SQL migrations
// since Prisma doesn't natively support spatial types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum UserRole {
  CITIZEN
  SURVEYOR
  CALA          // Competent Authority for Land Acquisition
  ADMINISTRATOR
  MINISTRY
}

enum StatutorySection {
  SEC_4         // Social Impact Assessment (SIA)
  SEC_6         // SIA Approval
  SEC_9         // Survey of Land
  SEC_11        // Preliminary Notification
  SEC_15        // Objection Hearing
  SEC_19        // Declaration of Acquisition
  SEC_23        // Award Determination
  SEC_30        // Solatium & Interest
  SEC_38        // Possession
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SLA_BREACHED
}

enum ProjectStatus {
  ON_TRACK
  AT_RISK
  SLA_BREACH
  COMPLETED
}

enum TitleStatus {
  CLEAR
  DISPUTED
}

enum LandUse {
  AGRICULTURAL
  COMMERCIAL
  RESIDENTIAL
  INDUSTRIAL
  FOREST
}

enum SoilClassification {
  IRRIGATED
  UNIRRIGATED
  BARREN
  WETLAND
}

enum SurveyStatus {
  VERIFIED
  DISPUTED
  PENDING_FIELD_VISIT
}

enum CompensationStatus {
  PENDING_ASSESSMENT
  AWARD_PUBLISHED
  DISBURSED
  ESCROW_LITIGATION
}

enum ObjectionStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum DBTStatus {
  QUEUED
  DISPATCHED
  CREDITED
  FAILED
}

enum DocumentType {
  SHAPEFILE
  GAZETTE
  RECEIPT
  DSC_SIGNED
  SIA_REPORT
  KHASRA_LIST
}

// ─────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────

/// User — RBAC-enabled actor in the system.
/// Simulates Keycloak multi-tier roles (CITIZEN → MINISTRY).
model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole
  agency              String?              // e.g. "NHAI", "Indian Railways"
  designation         String?              // e.g. "CALA", "District Collector"
  dscTokenSimulated   String?              // Simulated Class 3 DSC token
  aadhaarLinked       Boolean   @default(false)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  projectsCreated     Project[]            @relation("ProjectCreator")
  stagesCompleted     WorkflowStage[]      @relation("StageCompleter")
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@map("users")
}

/// Project — A land acquisition case/dossier.
/// Maps to frontend AcquisitionProject type.
model Project {
  id                       String          @id @default(cuid())
  code                     String          @unique    // e.g. "NHAI-DEL-MUM-PKG4"
  title                    String
  sponsoringAgency         String                     // e.g. "National Highways Authority of India (NHAI)"
  state                    String
  districts                String[]                   // PostgreSQL array
  totalAreaHa              Float
  acquiredAreaHa           Float           @default(0)
  affectedVillagesCount    Int             @default(0)
  affectedFamiliesCount    Int             @default(0)
  sanctionedBudgetCr       Float
  disbursedCompensationCr  Float           @default(0)
  currentStage             StatutorySection @default(SEC_4)
  stageProgress            Int             @default(0)  // 0-100
  status                   ProjectStatus   @default(ON_TRACK)
  slaWarning               Boolean         @default(false)
  slaDaysRemaining         Int             @default(60)
  startDate                DateTime
  targetCompletionDate     DateTime
  description              String
  officerName              String
  officerDesignation       String

  createdById              String
  createdBy                User            @relation("ProjectCreator", fields: [createdById], references: [id])

  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  // Relations
  parcels                  Parcel[]
  workflowStages           WorkflowStage[]
  documents                Document[]

  @@map("projects")
}

/// Parcel (Khasra) — Individual land parcel under acquisition.
/// PostGIS geometry stored via raw SQL (see migration).
/// Maps to frontend CadastralParcel type.
model Parcel {
  id                     String              @id @default(cuid())
  projectId              String
  project                Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  khasraNumber           String                        // e.g. "Plot 42A"
  village                String
  tehsil                 String
  district               String
  state                  String
  areaHa                 Float
  landUse                LandUse             @default(AGRICULTURAL)
  soilClassification     SoilClassification  @default(IRRIGATED)

  ownerName              String
  aadhaarLinked          Boolean             @default(false)
  panNo                  String?

  circleRatePerHa        Float                         // Government circle rate (₹ per Ha)
  saleDeedAvgRatePerHa   Float                         // Average of 3-year sale deeds (₹ per Ha)

  surveyStatus           SurveyStatus        @default(PENDING_FIELD_VISIT)
  titleStatus            TitleStatus         @default(CLEAR)
  disputeNotes           String?
  litigationReference    String?                       // Court case number if disputed

  structuresCount        Int                 @default(0)
  treesCount             Int                 @default(0)

  // Coordinates stored as JSON (lat/lng polygon) for API responses
  // PostGIS geometry column added via raw SQL migration
  coordinatesJson        Json                          // [[lat, lng], ...] polygon ring
  centerLat              Float
  centerLng              Float

  acquisitionStage       StatutorySection    @default(SEC_4)
  compensationStatus     CompensationStatus  @default(PENDING_ASSESSMENT)
  awardedAmountLakhs     Float?

  rowBufferApplied       Boolean             @default(false)

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  // Relations
  objections             Objection[]
  valuations             Valuation[]
  documents              Document[]

  @@map("parcels")
}

/// WorkflowStage — Tracks each statutory milestone for a project.
/// Part of the Camunda-inspired FSM (hand-rolled).
model WorkflowStage {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  section           StatutorySection
  status            StageStatus      @default(PENDING)
  slaDeadline       DateTime?
  slaDays           Int                               // Statutory SLA window in days
  startedAt         DateTime?
  completedAt       DateTime?
  completedById     String?
  completedBy       User?            @relation("StageCompleter", fields: [completedById], references: [id])
  escalationFlag    Boolean          @default(false)

  // Metadata for display
  name              String                            // e.g. "Social Impact Assessment (SIA)"
  actReference      String                            // e.g. "RFCTLARR Act 2013, Sec 4(1)"
  officerInCharge   String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([projectId, section])
  @@map("workflow_stages")
}

/// Objection — Section 15 objection filed against a parcel.
model Objection {
  id              String           @id @default(cuid())
  parcelId        String
  parcel          Parcel           @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  filedBy         String                              // Name of objector
  description     String
  status          ObjectionStatus  @default(OPEN)
  hearingDate     DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("objections")
}

/// Valuation — RFCTLARR Act 2013 statutory compensation computation.
/// Sections 26-30, First Schedule.
model Valuation {
  id                   String    @id @default(cuid())
  parcelId             String
  parcel               Parcel    @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  baseMarketValue      Float                          // Max(circleRate, saleDeedAvg) × area (₹ Lakhs)
  ruralMultiplier      Float                          // 1.00 to 2.00 per Sec 26(1)(b)
  multipliedValue      Float                          // baseMarketValue × ruralMultiplier
  assetValue           Float                          // structures + trees/crops (₹ Lakhs)
  solatium             Float                          // 100% of multipliedValue per Sec 30(1)
  interest             Float                          // 12% p.a., pro-rated days per Sec 30(3)
  interestMonths       Int                            // Number of months from Sec 11 to Award
  rrGrant              Float                          // R&R grant per Second Schedule
  totalAward           Float                          // Final payable amount (₹ Lakhs)

  formulaVersion       String    @default("RFCTLARR-2013-v1")
  signedByCala         Boolean   @default(false)
  signedAt             DateTime?
  computedAt           DateTime  @default(now())

  // Relations
  dbtTransactions      DBTTransaction[]

  @@map("valuations")
}

/// DBTTransaction — PFMS Direct Benefit Transfer ledger entry.
/// Mock service simulating UTR generation and bank credit status.
model DBTTransaction {
  id                     String     @id @default(cuid())
  valuationId            String
  valuation              Valuation  @relation(fields: [valuationId], references: [id], onDelete: Cascade)

  beneficiaryName        String
  beneficiaryAadhaarRef  String                       // SHA-256 hashed Aadhaar (privacy)
  bankAccountMasked      String                       // e.g. "XXXX1234"
  ifsc                   String
  utrNumber              String?                      // PFMS UTR number
  status                 DBTStatus  @default(QUEUED)
  amount                 Float                        // ₹ Lakhs
  dispatchedAt           DateTime?
  creditedAt             DateTime?

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@map("dbt_transactions")
}

/// AuditLog — Tamper-evident, SHA-256 hash-chained append-only log.
/// Every mutation writes an audit entry in the same transaction.
model AuditLog {
  id                String    @id @default(cuid())
  entityType        String                            // "PROJECT" | "PARCEL" | "VALUATION" | "WORKFLOW" | "DBT"
  entityId          String
  action            String                            // "CREATE" | "UPDATE" | "STAGE_ADVANCE" | "SLA_BREACH" | "DBT_DISPATCH" | "DSC_SIGN"
  actorId           String?
  actor             User?     @relation("AuditActor", fields: [actorId], references: [id])
  prevHash          String                            // SHA-256 of previous entry (or "GENESIS" for first)
  currHash          String                            // SHA-256(prevHash + payload + timestamp)
  payloadSnapshot   Json                              // Snapshot of entity state at time of action

  timestamp         DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

/// Document — File attachments (shapefiles, gazette notifications, receipts, signed docs).
model Document {
  id              String        @id @default(cuid())
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parcelId        String?
  parcel          Parcel?       @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  type            DocumentType
  fileName        String
  fileUrl         String
  mimeType        String?
  signed          Boolean       @default(false)
  signatureRef    String?                             // DSC signature reference

  createdAt       DateTime      @default(now())

  @@map("documents")
}
